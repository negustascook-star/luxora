# Luxora verify bot — ENV pavyzdys.
# Nukopijuok į failą pavadinimu ".env" tame pačiame aplanke ir užpildyk.
# NIEKADA nekelk .env į GitHub (tik .env.example).

# Boto tokenas iš Discord Developer Portal -> Bot -> Token
DISCORD_BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Application (client) ID — jau įrašytas
CLIENT_ID=1550135782570856558

# Client secret iš Developer Portal -> OAuth2 (reikia /callback veikimui)
CLIENT_SECRET=PASTE_CLIENT_SECRET_HERE

# Serverio (guild) ir rolės ID — jau įrašyti
GUILD_ID=1458179076190769287
VERIFY_ROLE_ID=1458539876226961479

# Viešas šito boto adresas, pvz: https://luxora-verify.xxx.railway.app
# Į jį DABAR pridėk "/callback" ir tą pilną URL įrašyk Developer Portal
# OAuth2 -> Redirects. Keičiant adresą nepamiršk atnaujinti ir portale.
BASE_URL=https://PASTE_HOST_URL_HERE

# Prievadas (hostingas dažnai pats duoda PORT kintamąjį)
PORT=3000
